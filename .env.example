# Supabase Auth (values from `npx supabase status -o env` in the backend repository)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# DocentAI API, called from the Next.js server only
API_BASE_URL=http://localhost:8000

# Pseudonymous students sign in with a code; the auth email is <code>@<domain> (backend R8)
PSEUDONYM_EMAIL_DOMAIN=students.docentai.invalid

# Contact shown on /acerca (to agree with the Data Protection Officer)
PRIVACY_CONTACT_EMAIL=
