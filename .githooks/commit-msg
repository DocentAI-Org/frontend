#!/usr/bin/env bash
# Commit message rules from the constitution (Development Workflow).
# Mirrored in the frontend and backend repositories: change both together.
#
#   <type>(<scope>)[!]: <description>      header of at most 72 characters
#   feat and fix must reference a task:   feat(chat): T045 grounded replies
#
# Usage: .githooks/commit-msg <message-file>
#        COMMIT_RULES=pr-title .githooks/commit-msg <file>   (PR titles: no task ID)

set -u

message_file="$1"
rules="${COMMIT_RULES:-commit}"
types="feat|fix|docs|test|build|ci|chore|refactor|perf|style|revert"
max_length=72

header="$(grep -v '^#' "$message_file" | sed -n '1p')"
second_line="$(grep -v '^#' "$message_file" | sed -n '2p')"

# Messages git writes itself.
case "$header" in
  "Merge "* | "Revert \""* | "fixup! "* | "squash! "* | "amend! "*) exit 0 ;;
esac

errors=()

if ! printf '%s' "$header" | grep -Eq "^($types)\([a-z0-9][a-z0-9-]*\)!?: [^ ].*[^ .]$"; then
  errors+=("The header must be '<type>(<scope>): <description>'.")
  errors+=("  types: ${types//|/, }")
  errors+=("  scope: lowercase, e.g. chat, material, spec, plan, tasks")
  errors+=("  description: no trailing period")
fi

# Characters, not bytes: descriptions are often in Spanish.
length="$(printf '%s' "$header" | iconv -f UTF-8 -t UTF-32LE 2>/dev/null | wc -c)"
length=$((length / 4))
if [ "$length" -gt "$max_length" ]; then
  errors+=("The header has $length characters; the maximum is $max_length.")
fi

if [ "$rules" = "commit" ] && printf '%s' "$header" | grep -Eq '^(feat|fix)[(!:]'; then
  if ! printf '%s' "$header" | grep -Eq '(^|[^A-Za-z0-9])T[0-9]{3}([^0-9]|$)'; then
    errors+=("feat and fix commits must reference a task ID, e.g. 'feat(chat): T045 ...'.")
  fi
fi

if [ -n "$second_line" ]; then
  errors+=("Leave a blank line between the header and the body.")
fi

if [ "${#errors[@]}" -gt 0 ]; then
  {
    echo "✗ Invalid commit message: $header"
    printf '  %s\n' "${errors[@]}"
    echo "  See CONTRIBUTING.md."
  } >&2
  exit 1
fi
