#!/usr/bin/env bash
# Fast local checks before each commit; CI runs the full suite.
set -eu

branch="$(git symbolic-ref --short HEAD 2>/dev/null || true)"
if [ "$branch" = "main" ]; then
  echo "✗ Do not commit on main: create a branch (NNN-feature or type/name)." >&2
  exit 1
fi

# Staged scripts. Checks read the working tree, so stage what you test.
lint_files=()
while IFS= read -r file; do
  lint_files+=("$file")
done < <(git diff --cached --name-only --diff-filter=ACMR -- '*.ts' '*.tsx' '*.js' '*.mjs')
if [ "${#lint_files[@]}" -gt 0 ]; then
  npx --no-install eslint "${lint_files[@]}"
fi
