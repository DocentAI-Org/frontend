{
  "name": "docentai-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "next typegen && node node_modules/typescript7/bin/tsc --noEmit",
    "api:types": "node scripts/api-types.mjs",
    "api:check": "node scripts/api-types.mjs --check",
    "test:e2e:app": "playwright test -c playwright.app.config.ts",
    "test:e2e:integration": "E2E_TARGET=integration playwright test -c playwright.app.config.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "katex": "0.19.1",
    "next": "16.4.5",
    "next-intl": "4.14.9",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/browser": "4.3.4",
    "@tailwindcss/postcss": "4.3.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vercel/config": "0.14.1",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.5",
    "jsdom": "29.1.1",
    "postcss": "8.5.32",
    "tailwindcss": "4.3.4",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript7": "npm:typescript@7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "overrides": {
    "@vercel/config": {
      "zod": "4.6.7"
    },
    "@vercel/routing-utils": {
      "path-to-regexp": "6.3.0"
    },
    "eslint-plugin-import": {
      "eslint": "$eslint"
    },
    "minimatch@^10": "11.0.4",
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "eslint-plugin-react": {
      "eslint": "$eslint"
    }
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "@swc/core": false,
    "fsevents": false,
    "unrs-resolver": false
  }
}
